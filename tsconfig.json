{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": [
            "ESNext"
        ],
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./src",
        "outDir": "./dist",
        "types": [
            "node"
        ],
        "paths": {
            "#*": [
                "./src/*",
            ],
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmitOnError": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "src"
    ]
}