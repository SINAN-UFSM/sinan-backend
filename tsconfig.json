{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": [
            "ESNext"
        ],
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "#*": [
                "./src/*.ts"
            ]
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmitOnError": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "drizzle.config.ts",
        "scripts"
    ]
}